{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fantasy Studio",
  "mainBinaryName": "FantasyStudio",
  "version": "1.3.0",
  "identifier": "ai.fantasylab.studio",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fantasy Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FantasyLab",
    "copyright": "FantasyLab. Business Source License 1.1.",
    "category": "Productivity",
    "shortDescription": "Type a sentence, get a game you can play and edit.",
    "longDescription": "Fantasy Studio turns a sentence into a playable 3D game you can edit by pointing at it, running entirely on your own computer.",
    "homepage": "https://github.com/bgrut/fantasy-studio",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../installer/engine-setup.ps1": "installer/engine-setup.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

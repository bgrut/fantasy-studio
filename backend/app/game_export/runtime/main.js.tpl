  function stepInteract(nt) {
    if (!interactables.length) return;
    let best = null, bd = 1e9;
    for (const t of interactables) {
      const d = Math.hypot(t.x - nt.x, t.z - nt.z);
      if (d < t.r + 0.8 && d < bd) { bd = d; best = t; }
    }
    if (best !== readable) {
      readable = best;

              if (shopK && rngK() < 0.5) boards.push([fxK, fzK, yawK]);
              else if (rngK() < 0.4) boxSpots.push([fxK, fzK, yawK]);
            }
            // standpipe: on the wall, always, because every building has one
            if (rngK() < 0.55) {

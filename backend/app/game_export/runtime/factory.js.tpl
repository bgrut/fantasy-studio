const TRADED = [INGOT, INGOT_E, INGOT_S, ALLOY];
const TRADE_NAME = { [INGOT]: 'crystal', [INGOT_E]: 'ember',
                     [INGOT_S]: 'salt', [ALLOY]: 'alloy' };
const TRADE_COL = { [INGOT]: '#9fd6ff', [INGOT_E]: '#ffae4d',
                    [INGOT_S]: '#d8e2f5', [ALLOY]: '#ff5ad9' };

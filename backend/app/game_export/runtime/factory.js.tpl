      const p = at(du, dv, 0.3 + Math.random() * 1.4);
      emit(p[0], p[1], p[2], (Math.random() - 0.5) * 0.2, (Math.random() - 0.5) * 0.2, (Math.random() - 0.5) * 0.2,

let minedWindow = 0;
let rateWindow = 0;
const rateBuckets = [];
const sparkHist = [];            // one entry per second, the last forty
function drawSpark() {
  const cv = document.getElementById('spark');
  if (!cv) return;
  const g = cv.getContext('2d'), W = cv.width, H = cv.height;
  g.clearRect(0, 0, W, H);
  if (sparkHist.length < 2) return;
  const max = Math.max(1, ...sparkHist);

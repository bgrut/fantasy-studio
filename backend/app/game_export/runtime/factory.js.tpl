  if (keys['Space'] && player.onGround) { player.vy = 6.4; player.onGround = false; }
  player.vy -= 19 * dt;
  player.h += player.vy * dt;
  if (player.h <= 0) { player.h = 0; player.vy = 0; player.onGround = true; }


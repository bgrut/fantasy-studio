  m.userData.fsTag = { type: 'ore', name: MINERAL_NAME[c.min] + ' seam',
                       detail: FACES[f].name + ' face · tile ' + i + ',' + j,
                       face: f, i, j,
                       get rich() { return Math.round(c.rich * 100) + '%'; } };

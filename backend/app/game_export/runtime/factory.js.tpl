      '<span class="px">' + PRICE[t].toFixed(2) + '</span>' +
      '<div class="pole"><div class="bar ' + (h >= 0 ? 'pos' : 'neg') +
      '" style="height:' + Math.max(2, Math.abs(h)) + 'px;background:' + TRADE_COL[t] + '"></div></div>' +
